{
  "name": "bb-plugin-profiles",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50.1 <0.51.0",
    "bbPluginSdk": ">=0.6.157 <0.7.0",
    "node": ">=22.19.0"
  },
  "bb": {
    "name": "Profiles",
    "description": "Choose which providers and models appear in the model picker for each project, and the default model new threads start on.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.105.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.50.1",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vite": "7.3.7",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck:fixture",
    "test": "vitest run",
    "build": "bb plugin build",
    "check:sdk": "node scripts/check-sdk.mjs",
    "format:check": "prettier --check \"*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{md,json}\" \"skills/**/*.md\" \".github/**/*.yml\" \"e2e/**/*.{ts,tsx,css,html,json,md}\" \"tasks/**/*.md\" \"docs/*.md\"",
    "format": "prettier --write \"*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{md,json}\" \"skills/**/*.md\" \".github/**/*.yml\" \"e2e/**/*.{ts,tsx,css,html,json,md}\" \"tasks/**/*.md\" \"docs/*.md\"",
    "check": "npm run format:check && npm run typecheck && npm run check:sdk && npm test && npm run build",
    "dev:fixture": "vite --config e2e/vite.config.ts",
    "typecheck:fixture": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "private": true,
  "license": "MIT",
  "description": "Choose which providers and models appear in the model picker for each project, and the default model new threads start on.",
  "files": [
    "dist/",
    "*.ts",
    "*.tsx",
    "*.css",
    "assets/",
    "components/",
    "lib/",
    "skills/",
    "scripts/",
    "docs/",
    "tsconfig.json",
    "LICENSE",
    "CHANGELOG.md",
    "PLUGIN_OVERVIEW.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ysskrishna/bb-plugin-model-manager.git"
  }
}
